{
  "name": "langcorrector-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de LangCorrector: una única extensión de VS Code (extensions/langcorrector) + un motor de corrección genérico (@langcorrector/engine) que interpreta packs de idioma — datos, no código. Empezamos con español (@langcorrector/pack-es).",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "package": "pnpm build && pnpm --filter langcorrector package",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "oxlint": "^1.82.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.0",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "oxlint"]
  }
}
