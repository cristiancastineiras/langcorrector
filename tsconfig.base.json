{
  "$schema": "https://json.schemastore.org/tsconfig",
  "docs": "Opciones de TypeScript compartidas por todos los paquetes del monorepo. Cada paquete la extiende y añade sus 'lib', 'types', 'outDir' e 'include'.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
